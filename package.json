{
  "name": "stauden-portal",
  "version": "1.0.0",
  "description": "KI-gestützte Bepflanzungsplanung mit Shop-Anbindung",
  "main": "stauden-server.js",
  "scripts": {
    "start": "node stauden-server.js",
    "dev": "nodemon stauden-server.js",
    "check:env": "node scripts/check-env-preflight.js",
    "check:env:strict": "node scripts/check-env-preflight.js --strict",
    "check:smoke": "node scripts/check-api-smoke.js",
    "check:security": "node test_security.js",
    "check:ki": "node scripts/check-ki-kennzeichnung.js",
    "check:pins": "node scripts/check-pin-deckung.js",
    "check:pin-meta": "node scripts/check-pin-metadaten.js",
    "check:selbsttest": "node scripts/check-ki-kennzeichnung.js --selbsttest && node scripts/check-pin-deckung.js --selbsttest && node scripts/check-pin-metadaten.js --selbsttest && node scripts/preis-spanne.js --selbsttest && node scripts/plan-pruefen.js --selbsttest",
    "ci:relaxed": "npm run check:env",
    "ci:strict": "npm run check:env:strict",
    "ci:smoke": "npm run check:smoke && npm run check:selbsttest",
    "check:lebensbereich": "node scripts/check-lebensbereich.js",
    "check:beispiele": "node scripts/check-beispielplaene.js",
    "ci:daten": "npm run check:ki && npm run check:pins && npm run check:pin-meta && npm run check:lebensbereich && npm run check:beispiele"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "nodemailer": "^9.0.3",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
