node_modules/
# Alle .env-Varianten sperren, nicht nur .env: eine .env.bak mit produktivem OpenAI-Key, SMTP-Zugang
# und Pixabay-Key lag unignoriert im Arbeitsbaum dieses ÖFFENTLICHEN Repos (gefunden 06.08.2026,
# nie committet). Die Vorlage bleibt ausdrücklich drin.
.env*
!.env.example
*.bak
stauden.db
stauden.db-wal
stauden.db-shm
*.db-wal
*.db-shm

# Erzeugte Pinterest-Pins (rund 70 MB). Entstehen aus DB und Skripten neu:
#   node scripts/pins-erzeugen.js
public/pins/

# Erzeugte Vorschaubilder der Ratgeber. Entstehen neu:
#   node scripts/og-ratgeber.js
public/og/

# Lokale Vorschau der Anfrage-Mails (test-mails/*.eml). Enthaelt Kundendaten aus Testlaeufen
# und hat in einem oeffentlichen Repo nichts verloren; entsteht neu beim naechsten Testlauf.
test-mails/

# Rohdaten des Gaissmayer-Preisabgleichs. Der Katalog ist deren vollstaendige Preisliste —
# dieses Repo ist oeffentlich, sie gehoert nicht hinein. Neu holen: scripts/preise-gaissmayer.js --holen
data/gaissmayer-katalog.json
data/gaissmayer-ohne-treffer.json

# Datenbank-Sicherungen und Kopien, die auf dem Server im Arbeitsbaum entstehen
# (stauden.db.bak-vor-preisen-20260901, staudenplan.db). Sie enthalten die Anfragen-Tabelle
# mit Kundendaten — in einem oeffentlichen Repo ein "git add -A" zu viel.
*.db
*.db.bak*
